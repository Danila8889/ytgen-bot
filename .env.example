# Names only - copy to .env for local runs; never commit real values. See README "Configuration".

# --- secrets (GitHub secrets in production) ---
BOT_TOKEN=
# Must equal the wrapper's BOT_SERVICE_API_KEY (generate once: openssl rand -hex 32)
BOT_SERVICE_API_KEY=

# --- non-secret (.env.production in production) ---
# Reachable FROM THE CONTAINER; in Docker use the public https URL, not 127.0.0.1 (see README).
WRAPPER_BASE_URL=
# Shown in /help and the withdrawal confirmation (e.g. @name)
SUPPORT_CONTACT=
# Optional: DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=
# Optional: heartbeat file read by the container healthcheck (default /tmp/ytgen-bot.heartbeat)
HEARTBEAT_FILE=
# Optional: docker log rotation (default 20m / 5 files)
DOCKER_LOG_MAX_SIZE=
DOCKER_LOG_MAX_FILE=

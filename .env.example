# Names only - copy to .env for local runs; never commit real values. See README "Configuration".

# --- secrets (GitHub secrets in production) ---
BOT_TOKEN=
# Must equal the wrapper's BOT_SERVICE_API_KEY (generate once: openssl rand -hex 32)
BOT_SERVICE_API_KEY=
# Password of the bot's own Postgres (openssl rand -hex 24). Used by the `db` service on its first start.
BOT_DB_PASSWORD=
# kie.ai API key for the AI layer
KIE_API_KEY=
# Numeric Telegram chat id that receives hand-off cards and AI alerts (and may use /paid)
MANAGER_CHAT_ID=

# --- non-secret (.env.production in production) ---
# Reachable FROM THE CONTAINER; in Docker use the public https URL, not 127.0.0.1 (see README).
WRAPPER_BASE_URL=
# Shown to users (/help, hand-off, withdrawal confirmation) and used for the "write to the manager" button (e.g. @name)
SUPPORT_CONTACT=
# Funnel database (the compose service is `db`; POSTGRES_HOST/PORT default to db / 5432)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PORT=
# AI layer: kie.ai chat completions, single provider, no failover (interim MVP choice - see README)
KIE_API_URL=
LLM_MODEL=
# Optional AI tuning (defaults in brackets): free questions per person per hour [10], LLM calls per UTC day [500],
# request timeout seconds [25], max reply tokens [600], temperature [0.2], consecutive failures that open the
# circuit breaker [5], breaker cooldown minutes [10], tariff cache TTL seconds [300]
AI_USER_HOURLY_LIMIT=
AI_DAILY_CEILING=
LLM_TIMEOUT_S=
LLM_MAX_TOKENS=
LLM_TEMPERATURE=
AI_BREAKER_FAILURES=
AI_BREAKER_COOLDOWN_MIN=
TARIFF_CACHE_TTL_S=
# Offsite backup remote read by scripts/backup_db.sh (production only)
RCLONE_REMOTE=
# Optional: DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=
# Optional: heartbeat file read by the container healthcheck (default /tmp/ytgen-bot.heartbeat)
HEARTBEAT_FILE=
# Optional: docker log rotation (default 20m / 5 files)
DOCKER_LOG_MAX_SIZE=
DOCKER_LOG_MAX_FILE=

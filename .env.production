# YouTubeGen Bot - production, NON-secret config (committed). Layer 1 of 2 of the deploy-time .env render:
# scripts/render_env.sh writes `.env` = this file + the GitHub secrets (BOT_TOKEN, BOT_SERVICE_API_KEY).
# Never put a credential here.

# The wrapper, as seen FROM THE BOT'S CONTAINER. The public https URL is used on purpose: the wrapper
# listens on the host's 127.0.0.1:8090, which is unreachable from a bridge-network container (its own
# loopback), and host.docker.internal cannot reach a loopback-only listener either. See README.
WRAPPER_BASE_URL=https://api.ytgenerator.ru

# Shown to users in /help and the withdrawal confirmation (owner-provided Telegram handle).
# REQUIRED: scripts/render_env.sh refuses to deploy when this is empty.
SUPPORT_CONTACT=@togn15

LOG_LEVEL=INFO

# --- funnel database: the bot's OWN Postgres (compose service `db`, internal network only) ---
# Non-secret names; the password is the GitHub secret BOT_DB_PASSWORD (rendered into .env by scripts/render_env.sh).
# POSTGRES_DB / POSTGRES_USER are also read by scripts/backup_db.sh and by ytgen-infra's backup watchdog.
POSTGRES_DB=ytgen_bot
POSTGRES_USER=ytgen_bot

# --- AI layer: kie.ai chat completions, ONE provider, NO failover (see README "AI layer" - interim MVP choice) ---
# The API key is the GitHub secret KIE_API_KEY.
KIE_API_URL=https://api.kie.ai
LLM_MODEL=gemini-3-8-flash-openai
# Free questions one person may ask per hour, and the global ceiling of LLM calls per UTC day.
AI_USER_HOURLY_LIMIT=10
AI_DAILY_CEILING=500

# --- offsite backup (scripts/backup_db.sh, installed by the owner as a host cron; watched by the backup watchdog) ---
RCLONE_REMOTE=beget:1fb4f6890744-pragmatic-senna/ytgen-bot

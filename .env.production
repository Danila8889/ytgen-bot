# YouTubeGen Bot - production, NON-secret config (committed). Layer 1 of 2 of the deploy-time .env render:
# scripts/render_env.sh writes `.env` = this file + the GitHub secrets (BOT_TOKEN, BOT_SERVICE_API_KEY).
# Never put a credential here.

# The wrapper, as seen FROM THE BOT'S CONTAINER. The public https URL is used on purpose: the wrapper
# listens on the host's 127.0.0.1:8090, which is unreachable from a bridge-network container (its own
# loopback), and host.docker.internal cannot reach a loopback-only listener either. See README.
WRAPPER_BASE_URL=https://api.ytgenerator.ru

# Shown to users in /help and the withdrawal confirmation (owner-provided Telegram handle).
# REQUIRED: scripts/render_env.sh refuses to deploy when this is empty.
SUPPORT_CONTACT=@togn15

LOG_LEVEL=INFO
